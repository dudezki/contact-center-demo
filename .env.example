# --- LiveKit Cloud (required). Get these from cloud.livekit.io -> Settings -> API keys ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- API service ---
ALLOWED_ORIGINS=http://localhost:5199,http://127.0.0.1:5199
RATE_LIMIT_PER_MINUTE=5
GLOBAL_RATE_LIMIT_PER_MINUTE=60
TRUST_PROXY_HEADERS=false

# --- Agent worker (LiveKit Inference model descriptors; swap freely) ---
AGENT_NAME=connect-agent
STT_MODEL=deepgram/nova-3
LLM_MODEL=openai/gpt-4.1-mini
TTS_MODEL=cartesia/sonic-3
MAX_CALL_SECONDS=60

# Web (display only; the agent enforces the real limit)
# VITE_CALL_LIMIT_SECONDS=60  (put in web/.env.local; defaults to 60)
